{
  "name": "sleazeburg-64",
  "version": "1.0.0",
  "private": true,
  "description": "A top-down crime satire for the browser, styled as a Commodore 64 game.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "start": "node tests/server.cjs 8064",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.cjs\"",
    "lint": "eslint js sidplayer.js tests",
    "format": "prettier --write \"js/*.js\" sidplayer.js \"tests/**/*.{js,cjs}\""
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "globals": "^16.0.0",
    "playwright": "1.63.0",
    "prettier": "^3.8.1"
  }
}
