{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sleazeburg 64",
  "version": "0.1.0",
  "identifier": "io.github.mselin.sleazeburg64",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node stage.mjs",
    "beforeDevCommand": "node stage.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.hvsc.c64.org",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "ArcadeGame",
    "shortDescription": "A totally original C64-style crime satire",
    "longDescription": "Sleazeburg 64: 8 bits, 16 colours, 0 scruples. A top-down crime satire in the style of the Commodore 64, with Discord Rich Presence built in.",
    "copyright": "Copyright (C) 2026 mselin. GNU GPL version 2 or later.",
    "license": "GPL-2.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
