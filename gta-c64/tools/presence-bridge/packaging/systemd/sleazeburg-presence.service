# Optional: starts the Sleazeburg 64 presence bridge when you log in to a graphical session.
#
#   mkdir -p ~/.config/systemd/user
#   cp sleazeburg-presence.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sleazeburg-presence
#
# It expects the program at ~/.local/bin/sleazeburg-presence; change ExecStart if you put it elsewhere.
# Logs: journalctl --user -u sleazeburg-presence -f
# Remove: systemctl --user disable --now sleazeburg-presence, then delete this file.

[Unit]
Description=Sleazeburg 64 presence bridge (Discord Rich Presence for the browser game)
Documentation=https://github.com/mselin/mselin.github.io/tree/main/gta-c64/tools/presence-bridge
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/sleazeburg-presence
Restart=on-failure
RestartSec=5

# It needs a loopback port and Discord's socket, and nothing else. These restrictions work in a user
# service without extra privileges. Options that need a mount or user namespace (ProtectSystem=, ProtectHome=,
# PrivateTmp= and the like) are left out on purpose: in a user service they depend on unprivileged user
# namespaces, which some distributions restrict, and the service would then fail to start.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=graphical-session.target
